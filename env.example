# ─── Database (Neon Postgres via Prisma) ──────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL=https://getmovecost.com
NEXTAUTH_SECRET=your-secret-here

# ─── Public base URL (used for sitemap, etc.) ─────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://getmovecost.com

# ─── Seed (only required when running `npm run db:seed` / `prisma db seed`) ───
INITIAL_ADMIN_PASSWORD=change-me-immediately
